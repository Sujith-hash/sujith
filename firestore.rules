rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 &&
             data.email is string && data.email.size() > 0 &&
             data.role is string && (data.role in ['CUSTOMER', 'MERCHANT', 'RIDER', 'ADMIN']) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('defaultAddress' in data) || (data.defaultAddress is string && data.defaultAddress.size() <= 300));
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() > 0 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.grandTotal is number && data.grandTotal >= 0 &&
             data.status is string && (data.status in ['PLACED', 'MERCHANT_ACCEPTED', 'PACKING', 'OUT_FOR_DELIVERY', 'NEARBY', 'DELIVERED', 'CANCELLED']) &&
             data.deliveryOtp is string && data.deliveryOtp.size() >= 4 &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 100)) &&
             (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 30)) &&
             (!('deliveryAddress' in data) || (data.deliveryAddress is string && data.deliveryAddress.size() <= 300)) &&
             (!('itemTotal' in data) || (data.itemTotal is number && data.itemTotal >= 0)) &&
             (!('liveProgress' in data) || (data.liveProgress is number && data.liveProgress >= 0.0 && data.liveProgress <= 1.0)) &&
             (!('paymentMethod' in data) || data.paymentMethod is string);
    }

    function isValidInventory(data) {
      return data.id is string && data.id.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.price is number && data.price >= 0 &&
             data.inStock is bool &&
             data.storeId is string && data.storeId.size() > 0 &&
             (!('categoryId' in data) || data.categoryId is string) &&
             (!('unit' in data) || (data.unit is string && data.unit.size() <= 50)) &&
             (!('emoji' in data) || (data.emoji is string && data.emoji.size() <= 10));
    }

    // User Profile
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt is timestamp &&
                       isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);

      // User Orders
      match /orders/{orderId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.createdAt is timestamp &&
                         isValidOrder(request.resource.data);
        allow update: if isOwner(userId) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         isValidOrder(request.resource.data);
        allow delete: if false; // Orders cannot be deleted
      }
    }

    // Store Inventory
    match /stores/{storeId}/inventory/{productId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidInventory(request.resource.data);
      allow delete: if isSignedIn();
    }

    // Fallback: Deny everything else
    match /{document=**} {
      allow read, write: false;
    }
  }
}
